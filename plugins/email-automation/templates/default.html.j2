<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #1e293b; max-width: 600px; margin: 0 auto; padding: 24px; }
  .content { font-size: 14px; margin-bottom: 24px; }
  .signature { font-size: 14px; color: #475569; border-top: 1px solid #e2e8f0; padding-top: 16px; margin-top: 24px; }
</style>
</head>
<body>
<div class="content">
  {{ body }}
</div>
{% if sender_name %}
<div class="signature">
  <p>Best regards,<br>{{ sender_name }}</p>
</div>
{% endif %}
</body>
</html>
